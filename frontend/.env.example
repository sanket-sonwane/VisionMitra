# Copy to `.env` and fill in real values. Never commit the real `.env`.

# Base URL of the VisionMitra backend as reachable from the device.
# - Android emulator: http://10.0.2.2:8001
# - iOS simulator:    http://127.0.0.1:8001
# - Physical device:  http://<your-lan-ip>:8001
EXPO_PUBLIC_BACKEND_URL=http://10.0.2.2:8001

# Optional: Expo tunnel subdomain for `expo start --tunnel`
# EXPO_TUNNEL_SUBDOMAIN=your-tunnel-subdomain

# Optional: SOS SMS strategy: "composer" (default) or "direct" (Android dev build)
# EXPO_PUBLIC_SOS_SMS_MODE=composer

EXPO_USE_FAST_RESOLVER=1
