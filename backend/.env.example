# Copy to `.env` and fill in real values. Never commit the real `.env`.

# MongoDB connection string (local instance or Atlas)
MONGO_URL=mongodb://localhost:27017

# Database name
DB_NAME=visionmitra

# YOLO obstacle-detection settings
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONF_THRESHOLD=0.35

# Vision AI is disabled unless explicitly enabled.
# Set to 1 to load the YOLO model and enable /api/detect-obstacles inference.
ENABLE_VISION_AI=0
